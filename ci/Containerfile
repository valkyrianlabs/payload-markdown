# CI build/test environment for payload-markdown.
#
# Playwright's own image (Ubuntu 24.04 with Chromium and every browser OS dependency for the
# Playwright version in pnpm-lock.yaml), plus the project's Node (.nvmrc) and pnpm
# (packageManager), git, the GitHub CLI and the ValkyrianLabs release tools. Built and run by
# ci/run-ci; nothing here touches the host.
# Pinned by digest; dev/ci.int.spec.ts keeps the tag in step with pnpm-lock.yaml's playwright.
FROM mcr.microsoft.com/playwright:v1.58.2-noble@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d

# .nvmrc and package.json "packageManager" (checked by dev/ci.int.spec.ts).
ARG NODE_VERSION=24.13.1
ARG PNPM_VERSION=10.33.0
# Newest vl-release / pmdocs in the ValkyrianLabs APT index when ci/run-ci built the image; part
# of the image tag, so a new tool release rebuilds the image.
ARG VALKYRIANLABS_TOOLS=""

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    COREPACK_HOME=/usr/local/share/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    HOME=/home/ci \
    CI=true

# Base tools. sudo is for CI steps that want root inside the container (apt installs and the
# like); every user in this container may use it, and container root is an unprivileged
# subordinate uid on the host.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg sudo xz-utils jq python3 python3-yaml \
 && echo 'ALL ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/ci \
 && chmod 0440 /etc/sudoers.d/ci \
 && rm -rf /var/lib/apt/lists/*

# Node from nodejs.org, verified against the release's SHASUMS256.txt.
RUN set -eux; \
    cd /tmp; \
    file="node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${file}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" | grep " ${file}\$" | sha256sum -c -; \
    tar -xJf "$file" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "$file"; \
    node --version; \
    corepack enable; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate; \
    chmod -R a+rX "$COREPACK_HOME"; \
    pnpm --version

# GitHub CLI (vlr github-release) and the ValkyrianLabs tools (vlr, pmdocs), from their signed
# APT repositories.
RUN set -eux; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli.gpg; \
    curl -fsSL https://apt.valkyrianlabs.com/pubkey.gpg -o /etc/apt/keyrings/valkyrianlabs.gpg; \
    chmod 0644 /etc/apt/keyrings/*.gpg; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/valkyrianlabs.gpg] https://apt.valkyrianlabs.com stable main" > /etc/apt/sources.list.d/valkyrianlabs.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh vl-release pmdocs; \
    rm -rf /var/lib/apt/lists/*; \
    echo "tools: ${VALKYRIANLABS_TOOLS}"; \
    vlr --version; pmdocs --version; gh --version | head -1

# HOME for whichever host uid ci/run-ci maps in (--userns=keep-id).
RUN install -d -m 1777 /home/ci

WORKDIR /workspace
